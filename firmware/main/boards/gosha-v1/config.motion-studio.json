{
    "target": "esp32s3",
    "builds": [
        {
            "name": "gosha-v1-motion-studio",
            "board_name": "GOSHA",
            "required_env_sdkconfig": [
                {
                    "env": "GOSHA_OTA_URL",
                    "config": "CONFIG_OTA_URL",
                    "kind": "url",
                    "redact": true
                }
            ],
            "sdkconfig_append": [
                "CONFIG_LANGUAGE_RU_RU=y",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"gosha\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"Гоша\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=38",
                "CONFIG_GOSHA_NO_MOTION_SAFE_PROFILE=y",
                "CONFIG_GOSHA_SAFE_NEUTRAL_BOOT_PROFILE=y",
                "CONFIG_GOSHA_MOTION_LIVE_LOCAL_OPT_IN=y",
                "CONFIG_GOSHA_MOTION_LIVE_RIGHT_ARM_LOCAL_OPT_IN=y",
                "CONFIG_GOSHA_MOTION_LIVE_USB_LOCAL_OPT_IN=y",
                "CONFIG_GOSHA_RUNTIME_MOTIONS=y",
                "CONFIG_GOSHA_VOICE_SERVER_AEC_NEGOTIATION=y",
                "CONFIG_GOSHA_OTA_REHOME_FROM_BUILD=y",
                "CONFIG_ESP_CONSOLE_UART_DEFAULT=y",
                "CONFIG_ESP_CONSOLE_SECONDARY_NONE=y",
                "CONFIG_SR_MN_EN_MULTINET6_QUANT=y",
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_CAMERA_OV2640=y",
                "CONFIG_CAMERA_OV2640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV2640_DVP_YUV422_240X240_25FPS=y",
                "CONFIG_CAMERA_OV3660=y",
                "CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV3660_DVP_YUV422_240X240_24FPS=y"
            ]
        }
    ]
}
